# Copy this file to .env.local and fill in your real key.
# Never commit .env.local to GitHub.

OPENAI_API_KEY=your_openai_api_key_here

# Optional: override the model used for YES/NO decisions.
# Verify current model names/availability at https://platform.openai.com/docs/models
# before relying on any specific value — model names get deprecated.
OPENAI_MODEL=gpt-5-mini

# Optional, only needed if you connect this app to Inngest Cloud instead of
# running the local Inngest dev server. See https://www.inngest.com/docs
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=
