# Copy this file to .env and adjust values

# Use SQLite for local dev (default) or Postgres for production
# SQLite:
DATABASE_URL=sqlite:///./app.db
# Postgres example (uncomment and edit):
# DATABASE_URL=postgresql://postgres:postgres@db:5432/leadplatform

SECRET_KEY=change-this-to-a-long-random-string-before-deploying
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of origins allowed to call the public submission API.
# Use "*" to allow any origin (widgets are meant to be embedded on arbitrary sites,
# so "*" is common here — the security boundary is per-widget validation, not CORS).
ALLOWED_ORIGINS=*

# Base URL where this backend is hosted (used to generate the embed script)
PUBLIC_BASE_URL=http://localhost:8000

# Rate limit for the public submission endpoint
SUBMISSION_RATE_LIMIT=5/minute
